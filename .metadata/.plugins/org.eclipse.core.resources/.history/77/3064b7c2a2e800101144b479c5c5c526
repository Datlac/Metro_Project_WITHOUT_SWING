package com.metro.app;

import com.metro.ui.ConsoleApp;
import com.metro.ui.MetroSystemUI;

import javax.swing.JOptionPane;
import javax.swing.SwingUtilities;

public class MetroLauncher {

    public static void main(String[] args) {
        // Tùy chọn hiển thị
        String[] options = {"Chế độ Console (Admin)", "Chế độ Swing (Visual)", "Thoát"};

        // Hiển thị Popup hỏi người dùng
        int choice = JOptionPane.showOptionDialog(
                null,
                "Bạn muốn chạy ứng dụng Metro ở chế độ nào?",
                "Chọn Giao Diện - Metro System",
                JOptionPane.DEFAULT_OPTION,
                JOptionPane.QUESTION_MESSAGE,
                null,
                options,
                options[1] // Mặc định chọn Swing
        );

        // Xử lý lựa chọn
        switch (choice) {
            case 0: // Console Mode
                System.out.println("Đang khởi động Console App...");
                // Gọi hàm main của ConsoleApp
                ConsoleApp.main(args);
                break;

            case 1: // Swing GUI Mode
                System.out.println("Đang khởi động Swing GUI...");
                // Chạy Swing trên luồng sự kiện riêng (EDT)
                SwingUtilities.invokeLater(() -> {
                    new MetroSystemUI().setVisible(true);
                });
                break;

            default: // Đóng hoặc chọn Thoát
                System.out.println("Đã thoát chương trình.");
                System.exit(0);
        }
    }
}