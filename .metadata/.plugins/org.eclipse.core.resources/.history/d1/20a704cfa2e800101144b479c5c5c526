package com.metro.app;

import com.metro.people.Customer;
import com.metro.app.DataLoader;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        System.out.println("=== METRO SYSTEM - LOADING DATA FROM FILE ===\n");
        System.out.println("Thư mục làm việc hiện tại: " + System.getProperty("user.dir"));
        // 1. Đọc dữ liệu từ file txt
        List<Customer> customers = DataLoader.loadCustomersFromFile();

        if (customers.isEmpty()) {
            System.out.println("Không tìm thấy dữ liệu khách hàng hoặc file lỗi.");
            return;
        }

        System.out.println("Đã tải thành công: " + customers.size() + " khách hàng.\n");

        // 2. In thông tin chi tiết từng khách
        for (Customer c : customers) {
            System.out.println("------------------------------------------------");
            System.out.println("KHÁCH HÀNG: " + c.getFullName() + " (ID: " + c.getCustomerId() + ")");
            System.out.println("Số dư hiện tại: " + c.getWalletBalance()); // Cần thêm getter cho walletBalance trong Class Customer
            
            // In danh sách vé (Sử dụng hàm in có sẵn hoặc viết mới)
            c.printHistory(); 
        }
    }
}