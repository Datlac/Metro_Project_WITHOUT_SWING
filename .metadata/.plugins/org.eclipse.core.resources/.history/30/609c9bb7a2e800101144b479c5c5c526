package com.metro.ui;

import com.metro.business.Ticket;
import com.metro.enums.CustomerType;
import com.metro.enums.TicketType;
import com.metro.people.Customer;
import com.metro.app.DataLoader;

import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;
import java.util.regex.Pattern;

public class ConsoleApp {

    // --- TASK 1.3: ANSI COLORS & FORMATTING ---
    private static final String RESET = "\u001B[0m";
    private static final String RED = "\u001B[31m";
    private static final String GREEN = "\u001B[32m";
    private static final String YELLOW = "\u001B[33m";
    private static final String BLUE = "\u001B[34m";
    private static final String CYAN = "\u001B[36m";

    // Data Management
    private static final Scanner scanner = new Scanner(System.in);
    private static List<Customer> customers = new ArrayList<>();
    private static Customer currentCustomer = null; // Giả lập login

    public static void main(String[] args) {
        // Load data ban đầu
        System.out.println(YELLOW + "Loading data..." + RESET);
        customers = DataLoader.loadCustomersFromFile();
        if (customers.isEmpty()) {
            // Tạo dữ liệu giả nếu file lỗi
            customers.add(new Customer("Admin User", "000000000", LocalDate.now(), "0900000000", "ADMIN", 10000.0, CustomerType.ADULT));
        }

        runMainMenu();
    }

    // --- TASK 1.1: MULTI-LEVEL MENU (Loop & Switch-Case) ---
    private static void runMainMenu() {
        boolean running = true;
        while (running) {
            printHeader("HỆ THỐNG QUẢN LÝ TÀU ĐIỆN METRO");
            System.out.println("1. Đăng nhập (Chọn User)");
            System.out.println("2. Quản trị viên (Admin)");
            System.out.println("3. Trợ giúp (Help)");
            System.out.println("4. Thoát");
            System.out.print("Chọn chức năng: ");

            int choice = validateInputInt(1, 4);

            switch (choice) {
                case 1:
                    runUserMenu();
                    break;
                case 2:
                    runAdminMenu();
                    break;
                case 3:
                    showHelp();
                    break;
                case 4:
                    System.out.println(YELLOW + "Đang thoát chương trình... Hẹn gặp lại!" + RESET);
                    running = false;
                    break;
            }
        }
    }

    private static void runUserMenu() {
        // Giả lập login: Chọn user đầu tiên hoặc tìm theo ID
        String custId = validateInputString("Nhập mã khách hàng (VD: C001): ", "^C\\d{3}$");
        currentCustomer = customers.stream()
                .filter(c -> c.getCustomerId().equals(custId))
                .findFirst()
                .orElse(null);

        if (currentCustomer == null) {
            printError("Không tìm thấy khách hàng có mã: " + custId);
            return;
        }

        printSuccess("Xin chào, " + currentCustomer.getFullName());

        boolean back = false;
        while (!back) {
            System.out.println("\n--- MENU KHÁCH HÀNG ---");
            System.out.println("1. Xem thông tin cá nhân & Số dư");
            System.out.println("2. Mua vé tàu");
            System.out.println("3. Xem lịch sử vé");
            System.out.println("4. Quay lại");
            System.out.print("Chọn: ");

            int choice = validateInputInt(1, 4);

            switch (choice) {
                case 1:
                    displayCustomerInfo(currentCustomer);
                    break;
                case 2:
                    handleBuyTicket();
                    break;
                case 3:
                    displayTicketHistory(currentCustomer);
                    break;
                case 4:
                    back = true;
                    break;
            }
        }
    }

    private static void runAdminMenu() {
        boolean back = false;
        while (!back) {
            System.out.println("\n" + RED + "--- MENU QUẢN TRỊ (ADMIN) ---" + RESET);
            System.out.println("1. Xem danh sách tất cả khách hàng");
            System.out.println("2. Thống kê doanh thu (Demo)");
            System.out.println("3. Quay lại");
            System.out.print("Chọn: ");

            int choice = validateInputInt(1, 3);

            switch (choice) {
                case 1:
                    displayAllCustomers();
                    break;
                case 2:
                    System.out.println(CYAN + "Tính năng đang phát triển..." + RESET);
                    break;
                case 3:
                    back = true;
                    break;
            }
        }
    }

    // --- TASK 1.2: INPUT VALIDATION (Try-Catch & Regex) ---
    
    // Validate số nguyên trong khoảng min-max
    private static int validateInputInt(int min, int max) {
        while (true) {
            try {
                String input = scanner.nextLine().trim();
                int value = Integer.parseInt(input);
                if (value >= min && value <= max) {
                    return value;
                } else {
                    printError("Vui lòng nhập số từ " + min + " đến " + max + ".");
                }
            } catch (NumberFormatException e) {
                printError("Lỗi: Dữ liệu nhập không phải là số hợp lệ!");
            }
        }
    }

    // Validate chuỗi theo Regex
    private static String validateInputString(String prompt, String regexPattern) {
        while (true) {
            System.out.print(prompt);
            String input = scanner.nextLine().trim();
            
            // Task 1.2: Regex Matching
            if (Pattern.matches(regexPattern, input)) {
                return input;
            } else {
                printError("Định dạng không hợp lệ. Vui lòng kiểm tra lại.");
                if (regexPattern.contains("C\\d{3}")) {
                    System.out.println(YELLOW + "(Gợi ý: Mã khách hàng dạng C001, C099...)" + RESET);
                }
            }
        }
    }

    // Validate tiền tệ (double)
    private static double validateInputDouble() {
        while (true) {
            try {
                String input = scanner.nextLine().trim();
                double value = Double.parseDouble(input);
                if (value > 0) return value;
                printError("Số tiền phải lớn hơn 0.");
            } catch (NumberFormatException e) {
                printError("Lỗi: Vui lòng nhập số thực (VD: 20.0).");
            }
        }
    }

    // --- TASK 1.3: DISPLAY IMPROVEMENT (Formatted Output) ---
    
    private static void printHeader(String title) {
        System.out.println("\n" + BLUE + "========================================");
        System.out.println("   " + title.toUpperCase());
        System.out.println("========================================" + RESET);
    }

    private static void printError(String msg) {
        System.out.println(RED + "[!] " + msg + RESET);
    }

    private static void printSuccess(String msg) {
        System.out.println(GREEN + "[✓] " + msg + RESET);
    }

    // Table View cho danh sách khách hàng
    private static void displayAllCustomers() {
        System.out.println("\n" + CYAN + "DANH SÁCH KHÁCH HÀNG" + RESET);
        // Table Header
        System.out.printf(BLUE + "%-10s | %-20s | %-15s | %-12s%n" + RESET, "ID", "HỌ TÊN", "LOẠI KHÁCH", "SỐ DƯ");
        System.out.println("---------------------------------------------------------------");
        
        for (Customer c : customers) {
            // String format table-like view
            System.out.printf("%-10s | %-20s | %-15s | %-12.1f%n", 
                    c.getCustomerId(), c.getFullName(), "MEMBER", c.getWalletBalance()); // Lưu ý: getMembershipLevel/Type cần có getter
        }
        System.out.println("---------------------------------------------------------------");
        System.out.println("Tổng số: " + customers.size() + " khách hàng.");
    }

    private static void displayCustomerInfo(Customer c) {
        printHeader("THÔNG TIN CÁ NHÂN");
        System.out.println("Họ tên: " + c.getFullName());
        System.out.println("CMND:   " + "********" + (c.getIdNumber() != null && c.getIdNumber().length() > 4 ? c.getIdNumber().substring(c.getIdNumber().length()-4) : ""));
        System.out.println("SĐT:    " + c.getPhoneNumber());
        System.out.printf("Số dư ví: " + YELLOW + "%.1f VND" + RESET + "%n", c.getWalletBalance());
    }
    
    // Table View cho lịch sử vé (Cần Customer có method getTicketHistory trả về List)
    private static void displayTicketHistory(Customer c) {
        // Vì class Customer cũ in ra console luôn, nên ta cần điều chỉnh.
        // Tốt nhất là thêm getter getTicketHistory() vào Customer.java.
        // Ở đây giả lập gọi hàm in có sẵn:
        System.out.println(CYAN + "\n--- LỊCH SỬ VÉ ---" + RESET);
        c.printHistory(); 
    }

    // Logic nghiệp vụ mua vé
    private static void handleBuyTicket() {
        System.out.println("\n--- MUA VÉ MỚI ---");
        System.out.println("1. Vé lượt (20.0)");
        System.out.println("2. Vé ngày (50.0)");
        System.out.println("3. Vé tháng (100.0)");
        System.out.print("Chọn loại vé: ");
        
        int typeChoice = validateInputInt(1, 3);
        TicketType type = TicketType.SINGLERIDE;
        double price = 20.0;

        switch (typeChoice) {
            case 2: type = TicketType.DAYPASS; price = 50.0; break;
            case 3: type = TicketType.MONTHLYPASS; price = 100.0; break;
        }

        // Tạo vé
        String ticketId = "T" + System.currentTimeMillis();
        Ticket newTicket = new Ticket(ticketId, price, type);

        if (currentCustomer.deductBalance(price)) {
            currentCustomer.addTicket(newTicket);
            printSuccess("Mua vé thành công! Mã vé: " + ticketId);
            System.out.println("Số dư còn lại: " + currentCustomer.getWalletBalance());
        } else {
            printError("Giao dịch thất bại: Số dư không đủ.");
        }
    }

    // --- TASK 1.4: HELP OPTION ---
    private static void showHelp() {
        printHeader("HƯỚNG DẪN SỬ DỤNG");
        System.out.println("1. " + YELLOW + "Đăng nhập:" + RESET + " Sử dụng mã khách hàng có trong file customers.txt (VD: C001, C002).");
        System.out.println("2. " + YELLOW + "Mua vé:" + RESET + " Chọn loại vé, hệ thống sẽ tự trừ tiền trong ví.");
        System.out.println("3. " + YELLOW + "Nạp tiền:" + RESET + " Hiện tại cần liên hệ Admin (hoặc sửa file txt) để nạp tiền.");
        System.out.println("4. " + YELLOW + "Lỗi nhập liệu:" + RESET + " Nếu nhập sai định dạng, hệ thống sẽ báo đỏ và yêu cầu nhập lại.");
        System.out.println("\n[Nhấn Enter để quay lại menu chính]");
        scanner.nextLine();
    }
}

