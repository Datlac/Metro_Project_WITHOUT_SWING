package com.metro.people;

import com.metro.business.Ticket;
import com.metro.enums.CustomerType;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

public class Customer extends Person {
    private String customerId;
    private int walletBalance;
    private CustomerType type;
    private List<Ticket> ticketHistory;

    public Customer(String fullName, String idNumber, LocalDate dob, String phoneNumber,
                    String customerId, int walletBalance, CustomerType type) {
        super(fullName, idNumber, dob, phoneNumber);
        this.customerId = customerId;
        this.walletBalance = walletBalance;
        this.type = type;
        this.ticketHistory = new ArrayList<>();
    }

    public boolean deductBalance(int amount) {
        if (walletBalance >= amount) {
            walletBalance -= amount;
            return true;
        }
        return false;
    }

    public void addTicket(Ticket ticket) {
        this.ticketHistory.add(ticket);
    }

    
    public void printHistory() {
        System.out.println("--- Ticket History for " + fullName + " ---");
        ticketHistory.forEach(t -> System.out.println(t)); 
    }

    public String getCustomerId() { return customerId; }
   
	public double getWalletBalance() {
		return walletBalance;
	}

	public void setWalletBalance(int walletBalance) {
		this.walletBalance = walletBalance;
	}

	public CustomerType getType() {
		return type;
	}

	public void setType(CustomerType type) {
		this.type = type;
	}

	public List<Ticket> getTicketHistory() {
		return ticketHistory;
	}

	public void setTicketHistory(List<Ticket> ticketHistory) {
		this.ticketHistory = ticketHistory;
	}

	public void setCustomerId(String customerId) {
		this.customerId = customerId;
	}
    
}