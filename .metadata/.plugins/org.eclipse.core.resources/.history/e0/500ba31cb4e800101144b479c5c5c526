package com.metro.ui;

import com.metro.business.Ticket;
import com.metro.enums.TicketType;
import com.metro.infrastructure.Line;
import com.metro.infrastructure.Station;
import com.metro.people.Customer;
import com.metro.transport.RoutePlanner;
import com.metro.transport.TrafficControl;
import com.metro.utils.DataLoader;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.text.DecimalFormat;
import java.util.ArrayList;
import java.util.List;
import java.util.Vector;

public class MetroSystemUI extends JFrame {

    // --- DỮ LIỆU CHUNG (Model) ---
    private List<Customer> customerList;
    private List<Ticket> allSoldTickets;
    
    // Dữ liệu cho phần Vận hành (Transport)
    private RoutePlanner routePlanner;
    private List<Station> allStations;

    // --- UI COMPONENTS ---
    // Tab Khách Hàng
    private JComboBox<String> userSelectCombo;
    private JLabel lblBalance;
    private JLabel lblName;
    private JTable userHistoryTable;
    private DefaultTableModel userHistoryModel;
    
    // Tab Admin
    private JLabel lblTotalRevenue;
    private JLabel lblTotalTickets;
    private JTable adminTable;
    private DefaultTableModel adminModel;

    // Tab Vận Hành (New)
    private JComboBox<String> cbStartStation;
    private JComboBox<String> cbEndStation;
    private JTextArea txtRouteResult;
    private JTextArea txtTrafficLog;

    public MetroSystemUI() {
        // 1. Load Dữ liệu & Khởi tạo hệ thống
        loadData();
        initTransportSystem(); // Khởi tạo bản đồ Metro

        // 2. Cấu hình cửa sổ chính
        setTitle("Metro System - Quản Lý Tập Trung");
        setSize(1100, 700); // Tăng kích thước chút để chứa đủ 3 tab
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        
        // 3. Tạo TabbedPane
        JTabbedPane tabbedPane = new JTabbedPane();
        tabbedPane.setFont(new Font("Arial", Font.BOLD, 14));

        tabbedPane.addTab("🛒 KHÁCH HÀNG", createCustomerPanel());
        tabbedPane.addTab("📊 QUẢN TRỊ", createAdminPanel());
        tabbedPane.addTab("🚆 VẬN HÀNH & ĐIỀU PHỐI", createOperationsPanel()); // Tab mới

        add(tabbedPane);
    }

    // --- SETUP DỮ LIỆU ---
    private void loadData() {
        customerList = DataLoader.loadCustomersFromFile();
        allSoldTickets = new ArrayList<>();
    }

    // Khởi tạo bản đồ Metro giả lập (giống Main.java cũ)
    private void initTransportSystem() {
        allStations = new ArrayList<>();
        
        Station s1 = new Station("S1", "Ben Thanh");
        Station s2 = new Station("S2", "Opera House");
        Station s3 = new Station("S3", "Ba Son"); 
        Station s4 = new Station("S4", "Van Thanh");
        Station s5 = new Station("S5", "Tan Cang");
        Station s6 = new Station("S6", "Thao Dien");

        allStations.add(s1); allStations.add(s2); allStations.add(s3);
        allStations.add(s4); allStations.add(s5); allStations.add(s6);

        Line line1 = new Line("L01", "Line 1");
        line1.addStation(s1); line1.addStation(s2); line1.addStation(s3); line1.addStation(s4);

        Line line2 = new Line("L02", "Line 2");
        line2.addStation(s3); line2.addStation(s5); line2.addStation(s6);

        List<Line> lines = new ArrayList<>();
        lines.add(line1);
        lines.add(line2);

        // Build Graph
        routePlanner = new RoutePlanner();
        routePlanner.buildGraph(lines);
    }

    // ==========================================
    // TAB 3: VẬN HÀNH & ĐIỀU PHỐI (NEW)
    // ==========================================
    private JPanel createOperationsPanel() {
        JPanel panel = new JPanel(new GridLayout(1, 2, 10, 10)); // Chia đôi màn hình trái/phải
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        // --- CỘT TRÁI: TÌM ĐƯỜNG (ROUTE FINDER) ---
        JPanel leftPanel = new JPanel(new BorderLayout());
        leftPanel.setBorder(BorderFactory.createTitledBorder("📍 Tìm Kiếm Lộ Trình"));

        JPanel inputPanel = new JPanel(new GridLayout(3, 2, 5, 10));
        
        // Populate ComboBox dữ liệu trạm
        Vector<String> stationNames = new Vector<>();
        for (Station s : allStations) {
            stationNames.add(s.getStationId() + " - " + s.getName()); // Hiển thị: S1 - Ben Thanh
        }

        cbStartStation = new JComboBox<>(stationNames);
        cbEndStation = new JComboBox<>(stationNames);
        // Chọn mặc định khác nhau để test cho nhanh
        if (stationNames.size() > 1) cbEndStation.setSelectedIndex(stationNames.size() - 1);

        JButton btnFindRoute = new JButton("TÌM ĐƯỜNG ĐI");
        btnFindRoute.setBackground(new Color(0, 128, 128));
        btnFindRoute.setForeground(Color.WHITE);
        btnFindRoute.setFont(new Font("Arial", Font.BOLD, 14));

        inputPanel.add(new JLabel("Ga Đi:"));
        inputPanel.add(cbStartStation);
        inputPanel.add(new JLabel("Ga Đến:"));
        inputPanel.add(cbEndStation);
        inputPanel.add(new JLabel("")); // Spacer
        inputPanel.add(btnFindRoute);

        // Kết quả tìm đường
        txtRouteResult = new JTextArea();
        txtRouteResult.setEditable(false);
        txtRouteResult.setFont(new Font("Monospaced", Font.BOLD, 14));
        txtRouteResult.setBorder(BorderFactory.createEtchedBorder());
        
        leftPanel.add(inputPanel, BorderLayout.NORTH);
        leftPanel.add(new JScrollPane(txtRouteResult), BorderLayout.CENTER);


        // --- CỘT PHẢI: TÌNH TRẠNG GIAO THÔNG (TRAFFIC STATUS) ---
        JPanel rightPanel = new JPanel(new BorderLayout());
        rightPanel.setBorder(BorderFactory.createTitledBorder("🚦 Tình Trạng Giao Thông (Live)"));

        JButton btnCheckTraffic = new JButton("KIỂM TRA HỆ THỐNG");
        btnCheckTraffic.setFont(new Font("Arial", Font.BOLD, 12));
        
        txtTrafficLog = new JTextArea();
        txtTrafficLog.setEditable(false);
        txtTrafficLog.setFont(new Font("Monospaced", Font.PLAIN, 12));
        txtTrafficLog.setBackground(Color.BLACK);
        txtTrafficLog.setForeground(Color.GREEN); // Chữ xanh lá trên nền đen giống hacker :D

        rightPanel.add(btnCheckTraffic, BorderLayout.NORTH);
        rightPanel.add(new JScrollPane(txtTrafficLog), BorderLayout.CENTER);


        // --- XỬ LÝ SỰ KIỆN (ACTIONS) ---

        // 1. Nút Tìm Đường
        btnFindRoute.addActionListener(e -> {
            String startSelection = (String) cbStartStation.getSelectedItem();
            String endSelection = (String) cbEndStation.getSelectedItem();

            // Tách lấy ID (VD: "S1 - Ben Thanh" -> lấy "S1")
            String startId = startSelection.split(" - ")[0];
            String endId = endSelection.split(" - ")[0];

            List<String> path = routePlanner.findShortestPath(startId, endId);

            if (path.isEmpty()) {
                txtRouteResult.setText("Không tìm thấy lộ trình!\n(Vui lòng kiểm tra lại kết nối tuyến)");
                txtRouteResult.setForeground(Color.RED);
            } else {
                StringBuilder sb = new StringBuilder();
                sb.append("--- LỘ TRÌNH TỐI ƯU ---\n");
                sb.append("Tổng số trạm: ").append(path.size()).append("\n\n");
                
                // Format: S1 -> S2 -> S3...
                String routeStr = String.join(" -> ", path);
                sb.append(routeStr);
                
                txtRouteResult.setText(sb.toString());
                txtRouteResult.setForeground(new Color(0, 0, 139)); // Dark Blue
            }
        });

        // 2. Nút Check Traffic
        btnCheckTraffic.addActionListener(e -> {
            txtTrafficLog.setText(""); // Xóa log cũ
            txtTrafficLog.append("--- ĐANG QUÉT HỆ THỐNG ---\n");
            
            // Giả lập check 5 chuyến tàu
            for (int i = 1; i <= 5; i++) {
                String tripId = "TRIP-00" + i;
                int delay = TrafficControl.checkDelay();
                
                String statusMsg;
                if (delay > 0) {
                    statusMsg = String.format("[⚠️ ALERT] Chuyến %s TRỄ %d phút.\n", tripId, delay);
                } else {
                    statusMsg = String.format("[✔ OK] Chuyến %s vận hành ĐÚNG GIỜ.\n", tripId);
                }
                txtTrafficLog.append(statusMsg);
            }
            txtTrafficLog.append("\n--- HOÀN TẤT ---");
        });

        // Add 2 cột vào panel chính
        panel.add(leftPanel);
        panel.add(rightPanel);

        return panel;
    }

    // ==========================================
    // TAB 1: KHÁCH HÀNG (Giữ nguyên code cũ)
    // ==========================================
    private JPanel createCustomerPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        JPanel topPanel = new JPanel(new GridLayout(2, 1, 5, 5));
        topPanel.setBorder(BorderFactory.createTitledBorder("Thông Tin Khách Hàng"));

        JPanel selectPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        selectPanel.add(new JLabel("Chọn Khách Hàng (Giả lập Login): "));
        
        Vector<String> customerNames = new Vector<>();
        for (Customer c : customerList) {
            customerNames.add(c.getCustomerId() + " - " + c.getFullName());
        }
        userSelectCombo = new JComboBox<>(customerNames);
        userSelectCombo.setPreferredSize(new Dimension(300, 25));
        selectPanel.add(userSelectCombo);

        JPanel infoPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        lblName = new JLabel("Tên: ---");
        lblBalance = new JLabel(" | Số Dư: 0.0 VND");
        lblBalance.setForeground(new Color(0, 100, 0));
        lblBalance.setFont(new Font("Arial", Font.BOLD, 14));
        infoPanel.add(lblName);
        infoPanel.add(lblBalance);

        topPanel.add(selectPanel);
        topPanel.add(infoPanel);

        JPanel buyPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        buyPanel.setBorder(BorderFactory.createTitledBorder("Mua Vé Mới"));
        
        JComboBox<TicketType> typeCombo = new JComboBox<>(TicketType.values());
        JTextField txtPrice = new JTextField("20.0", 5);
        JButton btnBuy = new JButton("MUA VÉ NGAY");
        btnBuy.setBackground(new Color(30, 144, 255));
        btnBuy.setForeground(Color.WHITE);

        buyPanel.add(new JLabel("Loại Vé:"));
        buyPanel.add(typeCombo);
        buyPanel.add(new JLabel("Giá (Test):"));
        buyPanel.add(txtPrice);
        buyPanel.add(btnBuy);

        String[] cols = {"Mã Vé", "Loại Vé", "Giá Tiền", "Trạng Thái"};
        userHistoryModel = new DefaultTableModel(cols, 0);
        userHistoryTable = new JTable(userHistoryModel);
        JScrollPane scrollHistory = new JScrollPane(userHistoryTable);
        scrollHistory.setBorder(BorderFactory.createTitledBorder("Lịch Sử Vé Của Khách"));

        userSelectCombo.addActionListener(e -> updateCurrentUserView());

        btnBuy.addActionListener(e -> {
            try {
                Customer current = getSelectedCustomer();
                if (current == null) return;

                double price = Double.parseDouble(txtPrice.getText());
                TicketType type = (TicketType) typeCombo.getSelectedItem();
                String ticketId = "T-" + System.currentTimeMillis();

                Ticket newTicket = new Ticket(ticketId, price, type);

                if (current.deductBalance(price)) {
                    current.addTicket(newTicket);
                    allSoldTickets.add(newTicket);
                    JOptionPane.showMessageDialog(this, "Mua vé thành công!", "Thông báo", JOptionPane.INFORMATION_MESSAGE);
                    updateCurrentUserView();
                    updateAdminStats();
                } else {
                    JOptionPane.showMessageDialog(this, "Số dư không đủ!", "Lỗi", JOptionPane.ERROR_MESSAGE);
                }
            } catch (NumberFormatException ex) {
                JOptionPane.showMessageDialog(this, "Giá tiền không hợp lệ.", "Lỗi Input", JOptionPane.WARNING_MESSAGE);
            }
        });

        panel.add(topPanel, BorderLayout.NORTH);
        
        JPanel centerContainer = new JPanel(new BorderLayout());
        centerContainer.add(buyPanel, BorderLayout.NORTH);
        centerContainer.add(scrollHistory, BorderLayout.CENTER);
        
        panel.add(centerContainer, BorderLayout.CENTER);

        if (customerList.size() > 0) {
            userSelectCombo.setSelectedIndex(0);
            updateCurrentUserView();
        }

        return panel;
    }

    // ==========================================
    // TAB 2: QUẢN TRỊ (Giữ nguyên code cũ)
    // ==========================================
    private JPanel createAdminPanel() {
        JPanel panel = new JPanel(new BorderLayout(10, 10));
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        JPanel statsPanel = new JPanel(new GridLayout(1, 2));
        statsPanel.setBorder(BorderFactory.createTitledBorder("Tổng Quan Doanh Thu Hệ Thống"));
        
        lblTotalRevenue = new JLabel("Doanh Thu: 0.0 VND");
        lblTotalRevenue.setFont(new Font("Arial", Font.BOLD, 18));
        lblTotalRevenue.setForeground(Color.RED);
        
        lblTotalTickets = new JLabel("Tổng Vé Bán: 0");
        lblTotalTickets.setFont(new Font("Arial", Font.BOLD, 18));
        lblTotalTickets.setForeground(Color.BLUE);
        
        statsPanel.add(lblTotalRevenue);
        statsPanel.add(lblTotalTickets);

        String[] cols = {"Mã Vé", "Khách Hàng", "Loại Vé", "Giá", "Ngày Mua"};
        adminModel = new DefaultTableModel(cols, 0);
        adminTable = new JTable(adminModel);
        JScrollPane scrollAdmin = new JScrollPane(adminTable);
        scrollAdmin.setBorder(BorderFactory.createTitledBorder("Chi Tiết Giao Dịch Toàn Hệ Thống"));

        JButton btnRefresh = new JButton("Làm Mới Dữ Liệu");
        btnRefresh.addActionListener(e -> updateAdminStats());

        panel.add(statsPanel, BorderLayout.NORTH);
        panel.add(scrollAdmin, BorderLayout.CENTER);
        panel.add(btnRefresh, BorderLayout.SOUTH);

        return panel;
    }

    // --- HELPER METHODS ---

    private Customer getSelectedCustomer() {
        int index = userSelectCombo.getSelectedIndex();
        if (index >= 0 && index < customerList.size()) {
            return customerList.get(index);
        }
        return null;
    }

    private void updateCurrentUserView() {
        Customer c = getSelectedCustomer();
        if (c != null) {
            lblName.setText("Tên: " + c.getFullName());
            DecimalFormat df = new DecimalFormat("#,###.0");
            lblBalance.setText(" | Số Dư: " + df.format(c.getWalletBalance()) + " VND");
            userHistoryModel.setRowCount(0);
        }
    }

    private void updateAdminStats() {
        adminModel.setRowCount(0);
        double totalRev = 0;
        for (Ticket t : allSoldTickets) {
            totalRev += t.getPrice();
            Object[] row = {
                t.getTicketId(), "Unknown", t.toString(), t.getPrice(), "Vừa xong"
            };
            adminModel.addRow(row);
        }
        DecimalFormat df = new DecimalFormat("#,###.0");
        lblTotalRevenue.setText("Doanh Thu: " + df.format(totalRev) + " VND");
        lblTotalTickets.setText("Tổng Vé Bán: " + allSoldTickets.size());
    }
}