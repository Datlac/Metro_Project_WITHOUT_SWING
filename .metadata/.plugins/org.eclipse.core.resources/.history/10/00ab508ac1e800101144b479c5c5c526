package com.metro.business;

import com.metro.enums.CustomerType;
import com.metro.enums.TicketType;
import java.util.HashMap;
import java.util.Map;

public class FareCalculator {

    // Bảng giá vé lượt theo Zone (Giữ nguyên)
    private static final double[] ZONE_PRICES = {
        6000.0, 8000.0, 9000.0, 11000.0, 13000.0, 15000.0, 17000.0, 19000.0
    };
    
    // BẢNG GIÁ VÉ ĐỊNH KỲ (CẬP NHẬT)
    public static final double PRICE_1_DAY_PASS = 40000.0;  // Mới: 40k
    public static final double PRICE_3_DAY_PASS = 90000.0;  // Cũ: 90k
    public static final double PRICE_MONTHLY_NORMAL = 200000.0;
    public static final double PRICE_MONTHLY_STUDENT = 150000.0;

    private static final Map<String, Integer> stationZones = new HashMap<>();

    static {
        // Init Zone (Giữ nguyên code cũ của bạn)
        String[] zone1 = {"Ben Thanh", "Nha Hat TP", "Ba Son", "Van Thanh", "Tan Cang", "Thao Dien", "An Phu"};
        for (String s : zone1) stationZones.put(s, 1);
        stationZones.put("Rach Chiec", 2);
        stationZones.put("Phuoc Long", 3);
        stationZones.put("Binh Thai", 4);
        stationZones.put("Thu Duc", 5);
        stationZones.put("Khu Cong Nghe Cao", 6);
        stationZones.put("Dai Hoc Quoc Gia", 7);
        stationZones.put("Ben Xe Suoi Tien", 8);
    }

    public static double calculateTripFare(String startStationName, String endStationName) {
        String start = cleanStationName(startStationName);
        String end = cleanStationName(endStationName);

        if (!stationZones.containsKey(start) || !stationZones.containsKey(end)) return 6000.0;

        int startZone = stationZones.get(start);
        int endZone = stationZones.get(end);
        int zoneDiff = Math.abs(endZone - startZone);

        if (zoneDiff >= ZONE_PRICES.length) zoneDiff = ZONE_PRICES.length - 1;

        return ZONE_PRICES[zoneDiff];
    }
    
    // CẬP NHẬT LOGIC TÍNH GIÁ VÉ ĐỊNH KỲ
    public static double calculatePassPrice(TicketType type, CustomerType customerType) {
        switch (type) {
            case DAYPASS:
                return PRICE_1_DAY_PASS; // 40.000
            case THREEDAYPASS:
                return PRICE_3_DAY_PASS; // 90.000
            case MONTHLYPASS:
                return (customerType == CustomerType.STUDENT) ? PRICE_MONTHLY_STUDENT : PRICE_MONTHLY_NORMAL;
            default:
                return 0;
        }
    }

    private static String cleanStationName(String rawName) {
        if (rawName.contains(" - ")) return rawName.split(" - ")[1];
        return rawName;
    }
}