package com.metro.transport;

import com.metro.infrastructure.Line;
import com.metro.infrastructure.Station;

import java.util.*;

public class RoutePlanner {

    // Adjacency List: Lưu trữ đồ thị (Mã trạm -> Danh sách các trạm kề nó)
    private Map<String, List<String>> networkGraph;

    public RoutePlanner() {
        this.networkGraph = new HashMap<>();
    }

    /**
     * Xây dựng đồ thị từ danh sách các Tuyến (Lines)
     * Duyệt qua từng Line, nối các trạm liền kề với nhau.
     */
    public void buildGraph(List<Line> lines) {
        networkGraph.clear();

        for (Line line : lines) {
            List<Station> stations = line.getStations();
            
            if (stations.size() < 2) continue;

            for (int i = 0; i < stations.size() - 1; i++) {
                String currentId = stations.get(i).getStationId();
                String nextId = stations.get(i + 1).getStationId();

                // Đồ thị vô hướng (Đi xuôi hay ngược đều được)
                addEdge(currentId, nextId);
                addEdge(nextId, currentId);
            }
        }
        System.out.println("Đã xây dựng bản đồ Metro với " + networkGraph.size() + " trạm kết nối.");
    }

    private void addEdge(String source, String destination) {
        networkGraph.computeIfAbsent(source, k -> new ArrayList<>()).add(destination);
    }

    /**
     * Tìm đường đi ngắn nhất (ít trạm nhất) bằng thuật toán BFS
     * @param startId ID trạm bắt đầu
     * @param endId ID trạm kết thúc
     * @return Danh sách ID các trạm cần đi qua
     */
    public List<String> findShortestPath(String startId, String endId) {
        if (!networkGraph.containsKey(startId) || !networkGraph.containsKey(endId)) {
            System.out.println("Lỗi: Trạm không tồn tại trong hệ thống.");
            return Collections.emptyList();
        }

        if (startId.equals(endId)) {
            return Collections.singletonList(startId);
        }

        // BFS Data Structures
        Queue<String> queue = new LinkedList<>();
        Set<String> visited = new HashSet<>();
        Map<String, String> parentMap = new HashMap<>(); // Để truy vết đường đi (Con -> Cha)

        // Init
        queue.add(startId);
        visited.add(startId);
        parentMap.put(startId, null);

        while (!queue.isEmpty()) {
            String current = queue.poll();

            // Nếu đã tìm thấy đích
            if (current.equals(endId)) {
                return reconstructPath(parentMap, endId);
            }

            // Duyệt các trạm kề
            List<String> neighbors = networkGraph.getOrDefault(current, new ArrayList<>());
            for (String neighbor : neighbors) {
                if (!visited.contains(neighbor)) {
                    visited.add(neighbor);
                    parentMap.put(neighbor, current); // Lưu vết: Để đến neighbor phải qua current
                    queue.add(neighbor);
                }
            }
        }

        System.out.println("Không tìm thấy đường đi từ " + startId + " đến " + endId);
        return Collections.emptyList();
    }

    // Truy vết ngược từ Đích về Nguồn để ra lộ trình
    private List<String> reconstructPath(Map<String, String> parentMap, String endId) {
        List<String> path = new LinkedList<>();
        String curr = endId;
        
        while (curr != null) {
            path.add(0, curr); // Thêm vào đầu danh sách để đảo ngược thứ tự
            curr = parentMap.get(curr);
        }
        return path;
    }
}